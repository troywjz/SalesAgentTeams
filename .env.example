# 服务名称、运行环境、监听地址和端口。
# Service name, runtime environment, bind address, and port.
APP_NAME=SalesAgentTeams 办公技能培训 Demo
APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=18100
APP_RELOAD=false

# 本地登录令牌的签名密钥和有效期。
# Signing key and lifetime for local login tokens.
APP_SECRET_KEY=windows-demo-secret-change-before-public-deployment
AUTH_TOKEN_TTL_SECONDS=43200

# Demo 数据与本地模型回退开关；不要把 DATABASE_URL 指向 Linux 生产库。
# Demo data and local-model fallback switches; never point DATABASE_URL at the Linux production database.
DEMO_MODE=true
DEMO_AGENT_DELAY_MS=60
DEMO_SEED_DATA=true

# 管理端账号；ADMIN_PASSWORD_HASH 非空时优先于 ADMIN_PASSWORD。
# Administrator account; a non-empty ADMIN_PASSWORD_HASH takes precedence over ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=

# Windows Python 连接独立的 sales_agent_demo PostgreSQL 数据库；连接串仅保留在本地。
# Windows Python connects to the isolated sales_agent_demo PostgreSQL database; keep this connection string local.
DATABASE_URL=postgresql+psycopg://sales_agent:change-me@127.0.0.1:15432/sales_agent_demo

# 数据库首次连接等待秒数；正式服务、启动脚本和评估回放共用。
# Seconds to wait for the initial database connection; shared by production service, startup script, and evaluation replay.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 聊天模型主供应商与故障回退顺序。
# Primary chat-model provider and fallback order.
LLM_PROVIDER=demo
LLM_PROVIDER_FALLBACK=

# 单次模型请求超时；模型尝试次数默认限制为 1，避免故障时重复消耗 API。
# Per-model-request timeout; attempts default to 1 to avoid repeated API cost on failures.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS_PER_REQUEST=1

# 推理模型的 reasoning token 预留预算；叠加到每次请求的 max_tokens 上，避免推理过程
# 耗尽预算导致无可见输出，reasoning-only 时还会触发同供应商放宽重试。非推理模型传 0。
# Reasoning-token budget for reasoning models; added to each request's max_tokens so the
# reasoning pass cannot exhaust the budget, and a reasoning-only response triggers a
# same-provider retry with a relaxed cap. Set to 0 for non-reasoning models.
LLM_REASONING_BUDGET_TOKENS=0

# 评测批量回放同时运行的独立对话数；按当前 API 频率限制和电脑性能调整，不改变单轮正式处理逻辑。
# Concurrent independent turns in batch evaluation; tune for API rate limits and hardware without changing production turn logic.
EVALUATION_MAX_CONCURRENCY=6

# MiniMax 聊天接口、密钥和模型；MODELS 可填写多个候选模型。
# MiniMax chat endpoint, key, and model; MODELS may contain multiple candidate models.
MINIMAX_API_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_MODELS=

# DeepSeek 聊天接口、密钥和模型；MODELS 可填写多个候选模型。
# DeepSeek chat endpoint, key, and model; MODELS may contain multiple candidate models.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=

# 阿里云百炼兼容接口、密钥和聊天模型。
# Alibaba DashScope-compatible endpoint, key, and chat model.
ALIYUN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_API_KEY=
ALIYUN_MODEL=
ALIYUN_MODELS=

# SiliconFlow 聊天接口、密钥和聊天模型。
# SiliconFlow chat endpoint, key, and chat model.
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
SILICONFLOW_MODELS=

# 整轮对话超时；正式对话与评估回放必须使用同一值。
# Whole-turn timeout shared by production chat and evaluation replay.
CHAT_REQUEST_TIMEOUT_SECONDS=300

# 连续客户消息的合并数量与流式回复分段参数。
# Consecutive-customer-message merge limit and streamed-reply chunk settings.
CHAT_MERGE_MAX_MESSAGES=3
CHAT_TURN_DEBOUNCE_SECONDS=0.15
AI_REPLY_CHUNK_DELAY_SECONDS=0.2
AI_REPLY_CHUNK_MAX_CHARS=45

# 是否从本地公开示例自动导入知识库。
# Whether to automatically import local public example knowledge.
KNOWLEDGE_AUTO_IMPORT=false

# SOP 自动跟进任务的开关、轮询间隔和单批数量。
# SOP follow-up task switch, polling interval, and batch size.
SOP_FOLLOWUP_ENABLED=true
SOP_FOLLOWUP_POLL_INTERVAL_SECONDS=2
SOP_FOLLOWUP_BATCH_SIZE=10

# Embedding 主供应商、回退顺序与单次请求超时。
# Embedding primary provider, fallback order, and per-request timeout.
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_PROVIDER_FALLBACK=aliyun
EMBEDDING_TIMEOUT_SECONDS=30

# SiliconFlow Embedding 接口、专用密钥和模型；专用密钥留空时可复用聊天密钥。
# SiliconFlow Embedding endpoint, dedicated key, and model; an empty dedicated key may reuse the chat key.
SILICONFLOW_EMBEDDING_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 阿里云 Embedding 接口、专用密钥和模型；专用密钥留空时可复用聊天密钥。
# Alibaba Embedding endpoint, dedicated key, and model; an empty dedicated key may reuse the chat key.
ALIYUN_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_EMBEDDING_API_KEY=
ALIYUN_EMBEDDING_MODEL=text-embedding-v4

# 向量风控开关、命中阈值和最多返回的候选规则数。
# Vector-safety switch, hit threshold, and maximum candidate-rule count.
SAFETY_VECTOR_ENABLED=false
SAFETY_VECTOR_THRESHOLD=0.78
SAFETY_VECTOR_TOP_K=3

# 销售案例 RAG 开关、召回数量、质量阈值和注入回复前的字符上限。
# Sales-case RAG switch, retrieval count, quality threshold, and reply-context character limit.
SALES_RAG_ENABLED=false
SALES_RAG_TOP_K=3
SALES_RAG_MIN_QUALITY_SCORE=0.45
SALES_RAG_MAX_REFERENCES=3
SALES_RAG_MAX_REFERENCE_CHARS=1200

# 新客户欢迎语：使用双引号保留多行，每一行会作为一条消息发送。
# New-customer welcome messages: keep multiple lines quoted; each line is sent as one message.
NEW_CUSTOMER_WELCOME_MESSAGES="你好，我是你的专属方案顾问，很高兴认识你
你目前更想提升日常办公效率，还是解决某个具体工作场景？"
